# ---------------------------------------------------------------------------
# Colonize API — development
# ---------------------------------------------------------------------------
# Loaded automatically when NODE_ENV=development (after `.env`, before real
# environment variables). These values restate the built-in defaults so the
# dev stack is explicit and reviewable; the API runs identically with this
# file deleted.
#
# Development uses the *embedded* driver: an in-process store with Mongo query
# semantics, persisting to backend/.runtime/data. Same schema registry, same
# business code, no mongod to install. Switch DB_DRIVER to `mongo` to run
# against a real server.

NODE_ENV=development
LOG_LEVEL=info
PRETTY_LOGS=false

PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
TRUST_PROXY=true
BODY_LIMIT=6mb

# Swagger is on in development: http://localhost:4000/docs/
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
# `*` so the sandbox/preview host and any local Vite port can call the API.
CORS_ORIGINS=*

DB_DRIVER=embedded
EMBEDDED_PERSIST=true
PLATFORM_DB_NAME=colonize_platform
TENANT_DB_PREFIX=colonize_s_

CACHE_DRIVER=memory
QUEUE_DRIVER=memory
JOBS_ENABLED=true
SCHEDULER_ENABLED=true

# The OTP code is returned in `meta.devOtp` so the §80 acceptance scenario can
# run without an SMS provider. Production forces this off regardless.
EXPOSE_DEV_OTP=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

PAYMENT_GATEWAY=mock
PAYMENT_MOCK_ENABLED=true

STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUDIT_ENABLED=true
REALTIME_ENABLED=true

WEB_ADMIN_URL=http://localhost:5173
WEB_SUPER_ADMIN_URL=http://localhost:5174
MOBILE_SCHEME=colonize

# ---- seeded demo accounts (well-known on purpose) ------------------------
# The §80 acceptance suite (npm run e2e -w @colonize/backend) logs in with these.
SEED_ON_START=false
DEMO_MODE=true
SEED_ALLOW_PRODUCTION=false
SEED_SUPER_ADMIN_EMAIL=superadmin@colonize.local
SEED_SUPER_ADMIN_PASSWORD=Colonize@Super1
SEED_SOCIETY_ADMIN_EMAIL=admin@greenvalley.local
SEED_SOCIETY_ADMIN_PASSWORD=GreenValley@1
SEED_SOCIETY_ADMIN_PHONE=+919800000001
SEED_DEMO_RESIDENT_PHONE=+919800000101
SEED_GUARD_PHONE=+919800000901
SEED_GUARD_PASSWORD=Guard@1234
