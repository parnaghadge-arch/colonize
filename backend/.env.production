# ---------------------------------------------------------------------------
# Colonize API — production
# ---------------------------------------------------------------------------
# Used by docker/docker-compose.yml (`env_file`). Compose overrides the
# DATABASE_URL / REDIS_URL / driver settings with service-discovery names, so
# the values here are for a standalone deployment.
#
# ⚠️  EVERY SECRET BELOW IS A PLACEHOLDER. Rotate all of them before this stack
#     is reachable from anywhere but your own machine:
#
#         openssl rand -hex 48    # JWT_SECRET, JWT_REFRESH_SECRET
#         openssl rand -hex 32    # QR_SIGNING_SECRET, MOCK_GATEWAY_SECRET,
#                                 # PAYMENT_WEBHOOK_SECRET
#
#     They are written out in full (rather than left empty) only so that
#     `docker compose up` produces a running stack to inspect. The API refuses
#     to boot in production with the *built-in* defaults, but it cannot tell a
#     placeholder from a real secret — that check is yours.
#     Never commit a file with real values: keep them in your secret manager
#     and inject them as real environment variables, which override this file.

NODE_ENV=production
LOG_LEVEL=info
PRETTY_LOGS=false

PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
# Set to the public origin (https://api.example.com) so OpenAPI servers[0].url
# and every generated link point at the real deployment.
# PUBLIC_URL=https://api.example.com
TRUST_PROXY=true
BODY_LIMIT=6mb

# Swagger: leave on behind your own auth/IP allowlist, or disable it outright.
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
# Explicit origins only. Never `*` with credentials in production.
CORS_ORIGINS=https://admin.example.com,https://superadmin.example.com

# ---- database: one database per society ----------------------------------
# A replica set is required — financial and visitor flows run in transactions.
DB_DRIVER=mongo
DATABASE_URL=mongodb://mongo:27017/?replicaSet=rs0
PLATFORM_DB_NAME=colonize_platform
TENANT_DB_PREFIX=colonize_s_

# ---- redis: shared cache, rate limits and job queue ----------------------
# Mandatory once more than one API replica runs: in-memory counters are
# per-process, so rate limits and the notification queue would not be shared.
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_URL=redis://redis:6379
JOBS_ENABLED=true
SCHEDULER_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# ---- secrets (ROTATE) ----------------------------------------------------
JWT_SECRET=REPLACE_ME_openssl_rand_hex_48_access_token_signing_secret
JWT_REFRESH_SECRET=REPLACE_ME_openssl_rand_hex_48_refresh_token_signing_secret
JWT_ISSUER=colonize.platform
JWT_AUDIENCE=colonize.clients
JWT_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_MAX_ACTIVE_DEVICES=5
QR_SIGNING_SECRET=REPLACE_ME_openssl_rand_hex_32_gate_pass_signing_key
APP_PIN_ENABLED=true

# ---- OTP: never expose codes in a response -------------------------------
EXPOSE_DEV_OTP=false
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---- notification providers ----------------------------------------------
# `console` logs instead of sending. Swap in the real provider and its
# credentials before go-live, or residents will not receive gate alerts.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

# ---- payments -------------------------------------------------------------
# `mock` keeps the gateway flow exercisable without merchant credentials.
# For real collections set PAYMENT_GATEWAY=razorpay and supply the three keys;
# the webhook secret must match the one configured in the gateway dashboard.
PAYMENT_GATEWAY=mock
PAYMENT_MOCK_ENABLED=true
MOCK_GATEWAY_SECRET=REPLACE_ME_openssl_rand_hex_32_mock_gateway_hmac_key
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_openssl_rand_hex_32_gateway_webhook_secret

# ---- storage --------------------------------------------------------------
# `local` writes to backend/.runtime/storage (a compose volume). For more than
# one API replica use S3 so any node can serve any document.
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

# ---- hardening ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUDIT_ENABLED=true
REALTIME_ENABLED=true

# ---- demo behaviour OFF ---------------------------------------------------
DEMO_MODE=false
SEED_ON_START=false
# The seeder refuses to run in production unless this is true. Leave it false
# in a real deployment; docker-compose sets it only for the one-shot `seed`
# profile service.
SEED_ALLOW_PRODUCTION=false
