# ---------------------------------------------------------------------------
# Colonize API — environment template
# ---------------------------------------------------------------------------
# Copy to `.env.development` or `.env.production` and edit. Loading order is
#   .env  →  .env.<NODE_ENV>  →  real environment variables   (later wins)
# so a container's environment always overrides these files.
#
# Every variable below has a working default in backend/src/config/env.ts; this
# file exists to document them. Nothing about a society, a plan or a business
# rule is configured here — only infrastructure and provider selection.

NODE_ENV=development
LOG_LEVEL=info
PRETTY_LOGS=true

# ---- HTTP ---------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
VERSION=1.0.0
# Externally reachable origin. Sets OpenAPI servers[0].url so "Try it out"
# works behind a reverse proxy or sandbox preview host.
# PUBLIC_URL=   ← set this; left commented so it does not blank the built-in default
TRUST_PROXY=true
# Sized for the CSV unit-import wizard (a pasted 800-row spreadsheet).
BODY_LIMIT=6mb
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- database -----------------------------------------------------------
# mongo    → real MongoDB (production, Docker)
# embedded → in-process engine with Mongo query semantics (dev/CI, no mongod)
DB_DRIVER=embedded
DATABASE_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
PLATFORM_DB_NAME=colonize_platform
TENANT_DB_PREFIX=colonize_s_
# Embedded driver only:
# EMBEDDED_DATA_DIR=   ← set this; left commented so it does not blank the built-in default
EMBEDDED_PERSIST=true

# ---- cache / queue ------------------------------------------------------
# memory is per-process; redis is required as soon as there is more than one
# API replica, otherwise rate limits and the job queue are not shared.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
JOBS_ENABLED=true
SCHEDULER_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# ---- auth / tokens ------------------------------------------------------
# REQUIRED in production: the API refuses to boot with the built-in defaults.
#   openssl rand -hex 48
# JWT_SECRET=   ← set this; left commented so it does not blank the built-in default
# JWT_REFRESH_SECRET=   ← set this; left commented so it does not blank the built-in default
JWT_ISSUER=colonize.platform
JWT_AUDIENCE=colonize.clients
JWT_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_MAX_ACTIVE_DEVICES=5
# QR_SIGNING_SECRET=   ← set this; left commented so it does not blank the built-in default
APP_PIN_ENABLED=true

# ---- OTP ----------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Returns the code in `meta.devOtp` so the §80 scenario can be run without an
# SMS provider. FORCED OFF in production regardless of this value.
EXPOSE_DEV_OTP=true

# ---- notifications ------------------------------------------------------
SMS_PROVIDER=console          # console | twilio | msg91 | gupshup | textlocal
# SMS_API_KEY=   ← set this; left commented so it does not blank the built-in default
# SMS_SENDER_ID=   ← set this; left commented so it does not blank the built-in default
EMAIL_PROVIDER=console        # console | smtp | ses | sendgrid
# SMTP_HOST=   ← set this; left commented so it does not blank the built-in default
SMTP_PORT=587
# SMTP_USER=   ← set this; left commented so it does not blank the built-in default
# SMTP_PASS=   ← set this; left commented so it does not blank the built-in default
# SMTP_FROM=   ← set this; left commented so it does not blank the built-in default
PUSH_PROVIDER=console         # console | fcm | expo
# FCM_PROJECT_ID=   ← set this; left commented so it does not blank the built-in default
# FCM_SERVER_KEY=   ← set this; left commented so it does not blank the built-in default
# EXPO_PUSH_TOKEN=   ← set this; left commented so it does not blank the built-in default
# WHATSAPP_PROVIDER=   ← set this; left commented so it does not blank the built-in default

# ---- payments -----------------------------------------------------------
PAYMENT_GATEWAY=mock          # razorpay | mock | none
PAYMENT_MOCK_ENABLED=true
# MOCK_GATEWAY_SECRET=   ← set this; left commented so it does not blank the built-in default
# PAYMENT_WEBHOOK_SECRET=   ← set this; left commented so it does not blank the built-in default
# RAZORPAY_KEY_ID=   ← set this; left commented so it does not blank the built-in default
# RAZORPAY_KEY_SECRET=   ← set this; left commented so it does not blank the built-in default
# RAZORPAY_WEBHOOK_SECRET=   ← set this; left commented so it does not blank the built-in default
RAZORPAY_BASE_URL=https://api.razorpay.com

# ---- storage ------------------------------------------------------------
STORAGE_PROVIDER=local        # local | s3
# LOCAL_STORAGE_DIR=   ← set this; left commented so it does not blank the built-in default
MAX_UPLOAD_MB=10
# ALLOWED_UPLOAD_MIME=   ← set this; left commented so it does not blank the built-in default
# S3_BUCKET=   ← set this; left commented so it does not blank the built-in default
# S3_REGION=   ← set this; left commented so it does not blank the built-in default
# S3_ENDPOINT=   ← set this; left commented so it does not blank the built-in default
# S3_ACCESS_KEY=   ← set this; left commented so it does not blank the built-in default
# S3_SECRET_KEY=   ← set this; left commented so it does not blank the built-in default
# S3_PUBLIC_URL=   ← set this; left commented so it does not blank the built-in default
S3_FORCE_PATH_STYLE=false

# ---- rate limiting / audit ----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUDIT_ENABLED=true

# ---- realtime -----------------------------------------------------------
REALTIME_ENABLED=true

# ---- clients (deep links, not authorisation) ----------------------------
WEB_ADMIN_URL=http://localhost:5173
WEB_SUPER_ADMIN_URL=http://localhost:5174
MOBILE_SCHEME=colonize

# ---- seed / demo --------------------------------------------------------
SEED_ON_START=false
DEMO_MODE=true
# The seeder refuses to run when NODE_ENV=production unless this is set.
SEED_ALLOW_PRODUCTION=false
SEED_SUPER_ADMIN_EMAIL=superadmin@colonize.local
SEED_SUPER_ADMIN_PASSWORD=Colonize@Super1
SEED_SOCIETY_ADMIN_EMAIL=admin@greenvalley.local
SEED_SOCIETY_ADMIN_PASSWORD=GreenValley@1
SEED_SOCIETY_ADMIN_PHONE=+919800000001
SEED_DEMO_RESIDENT_PHONE=+919800000101
SEED_GUARD_PHONE=+919800000901
SEED_GUARD_PASSWORD=Guard@1234
