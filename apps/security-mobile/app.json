{
  "expo": {
    "name": "Colonize Security",
    "slug": "colonize-security",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f14",
    "scheme": "colonize-security",
    "icon": "./assets/icon.png",
    "favicon": "./assets/favicon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colonize.security",
      "infoPlist": {
        "NSCameraUsageDescription": "Colonize Security scans QR gate passes to admit and release visitors at the gate.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.colonize.security",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Colonize Security scans QR gate passes to admit and release visitors at the gate.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0f14"
        }
      ]
    ]
  }
}
