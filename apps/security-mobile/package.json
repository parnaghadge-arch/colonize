{
  "name": "@colonize/security-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Colonize Security App — the gate guard's console: shift in/out, live gate queue, QR scanning for entry/exit, manual entries and the crossing log. Expo SDK 57 / React Native.",
  "main": "index.ts",
  "scripts": {
    "predev": "npm run build -w @colonize/shared --if-present",
    "dev": "expo start --go",
    "start": "expo start --go",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export:web": "expo export --platform web",
    "clean": "rm -rf dist .expo *.tsbuildinfo"
  },
  "dependencies": {
    "@colonize/shared": "*",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
