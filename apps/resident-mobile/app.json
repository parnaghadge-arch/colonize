{
  "expo": {
    "name": "Colonize Resident",
    "slug": "colonize-resident",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f6f8",
    "scheme": "colonize-resident",
    "icon": "./assets/icon.png",
    "favicon": "./assets/favicon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colonize.resident",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.colonize.resident",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f6feb"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f6f8"
        }
      ]
    ]
  }
}
